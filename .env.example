# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# Free key from https://aistudio.google.com/apikey  (leave empty = chat falls back to simple keyword mode)
GEMINI_API_KEY=
# Alias that always points at the current small/cheap Gemini model. Change if Google renames it.
GEMINI_MODEL=gemini-flash-lite-latest

# Long random string (64 characters) used to sign logins and encrypt customers' AI keys.
# On your own computer it may stay empty (one is made and saved in data/.secret). On the live server it is REQUIRED.
# Keep it the same forever: if it changes, everyone must log in again and saved AI keys must be entered again.
JWT_SECRET=

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put the database name before the "?", e.g.
# mongodb+srv://boathouse_app:PASSWORD@cluster0.xxxxx.mongodb.net/boathouse?retryWrites=true&w=majority
# (memory:// runs without a database for quick tests: everything is lost when the server stops)
MONGODB_URI=
# Optional: database name if it is not in the connection string (default "boathouse")
MONGODB_DB=

# Owners cannot sign up themselves. Create them with: npm run add-owner
# (leave this false; true only re-opens the old sign-up API for testing)
ALLOW_SIGNUP=false

# Only needed after you host the frontend separately (e.g. Netlify). Comma separated origins.
CORS_ORIGIN=

# Set to true ONLY when the app runs behind one proxy that sets X-Forwarded-For (Render, Railway, Nginx).
# It makes login limits use the visitor's real IP and turns on HTTPS-only (HSTS). Leave false on your own computer.
TRUST_PROXY=false

# Time zone used for "today" / "tomorrow"
APP_TZ=Asia/Kolkata

# Shown to a boat owner when their trial ends or the account is locked, e.g. "WhatsApp 98xxxxxx12"
CONTACT_INFO=

# Only for `npm run test:atlas`: runs the tests on a real MongoDB. Each run makes temporary bh_test_... databases and empties them.
# Use a test cluster or a user that may create databases. Leave empty normally (npm test needs no database).
TEST_MONGODB_URI=
