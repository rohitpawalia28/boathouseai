# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# Free key from https://aistudio.google.com/apikey  (leave empty = chat falls back to simple keyword mode)
GEMINI_API_KEY=
# Alias that always points at the current small/cheap Gemini model. Change if Google renames it.
GEMINI_MODEL=gemini-flash-lite-latest

# Long random string used to sign login tokens. If empty, one is generated and saved in data/.secret
JWT_SECRET=

# Where the SQLite file lives
DB_FILE=data/boathouse.db

# Owners cannot sign up themselves. Create them with: npm run add-owner
# (leave this false; true only re-opens the old sign-up API for testing)
ALLOW_SIGNUP=false

# Only needed after you host the frontend separately (e.g. Netlify). Comma separated origins.
CORS_ORIGIN=

# Set to true ONLY when the app runs behind one proxy that sets X-Forwarded-For (Render, Railway, Nginx).
# It makes login limits use the visitor's real IP and turns on HTTPS-only (HSTS). Leave false on your own computer.
TRUST_PROXY=false

# Time zone used for "today" / "tomorrow"
APP_TZ=Asia/Kolkata

# Shown to a boat owner when their trial ends or the account is locked, e.g. "WhatsApp 98xxxxxx12"
CONTACT_INFO=
